# Ejemplo de entorno para @private-chat/api (desarrollo local).
# NUNCA pongas secretos reales aquí ni imprimas DATABASE_URL en logs.
APP_ENV=development
APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3001

# Conexión del runtime (migraciones/seed/grant usan OWNER_DATABASE_URL).
DATABASE_URL=postgresql://private_chat_app@localhost:5432/private_chat
# Alternativa por partes:
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_NAME=private_chat
# DATABASE_USER=private_chat_app
# DATABASE_PASSWORD_FILE=/run/secrets/db_password

# Propietario para migraciones y seed (db:migrate, db:seed, db:grant):
# OWNER_DATABASE_URL=postgresql://private_chat_owner@localhost:5432/private_chat

# Archivos con secretos (requeridos en producción):
# COOKIE_SECRET_FILE=/run/secrets/cookie_secret
# CSRF_SECRET_FILE=/run/secrets/csrf_secret

UPLOAD_DIR=./data/uploads
DELETION_JOURNAL_PATH=./data/deletion-journal.jsonl
ADMIN_USERNAME=admin
PARTNER_USERNAME=member

# Contraseñas iniciales del seed (archivos, nunca valores en claro aquí):
# ADMIN_PASSWORD_FILE=/run/secrets/admin_password
# MEMBER_PASSWORD_FILE=/run/secrets/member_password

# Base dedicada para pruebas de integración (nunca la de uso):
# TEST_DATABASE_URL=postgresql://postgres@localhost:5432/private_chat_test

# Nombres visibles y avatares iniciales opcionales (sólo seed).
ADMIN_DISPLAY_NAME=Administrador
MEMBER_DISPLAY_NAME=Miembro
# ADMIN_AVATAR_FILE=/ruta/privada/admin.png
# MEMBER_AVATAR_FILE=/ruta/privada/member.png
